# LLM — Groq
groq_api_key=gsk-your-key-here
llm_model=openai/gpt-oss-120b

# Embeddings — Ollama
embedding_model=snowflake-arctic-embed:137m
ollama_base_url=http://localhost:11434

# API auth
API_KEY=your-secret-api-key-here

# Paths
DATA_DIR=./data
CHROMA_PERSIST_DIR=./storage/chroma
TASK_STORE_DIR=./storage/tasks

# RAG settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_TOP_K=4

# Guardrails
MAX_QUESTION_LENGTH=2000
BLOCKED_TOPICS=

# Upload limits
MAX_UPLOAD_SIZE_MB=50

# API server (uvicorn dev / gunicorn bind)
API_HOST=0.0.0.0
API_PORT=8000

# Gunicorn production settings
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=2
GUNICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=50
GUNICORN_LOG_LEVEL=info
GUNICORN_RELOAD=false
GUNICORN_PRELOAD=false

# Application logging (stdout — works for local terminal and docker logs)
LOG_LEVEL=INFO
LOG_FORMAT=text
# LOG_FORMAT=json
# LOG_FILE=./storage/app.log

# Docker: use host Ollama from container
# OLLAMA_BASE_URL=http://host.docker.internal:11434
